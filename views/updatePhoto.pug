extends layout

block content

  h1 Update Photo Info
  .row
    .col-md-6.col-md-offset-3
        if flashPhotoFindError.length > 0
          .alert.alert-danger <strong>FLASH!</strong>#{flashPhotoFindError}
        p Title: #{photo.title} 
        p Description: #{photo.description}
        p Size: #{photo.size} | Filename: #{photo.originalname} | Uploaded: #{photo.createdAt}| Modified: #{photo.updatedAt}
        img(src=photo.imageurl, width="250")
        form(method='POST' action="/photos/"+photo._id)
          div.form-group
            label(for='title') Photo Title :
            input#name.form-control(type='text', value=photo.title name='title')
          div.form-group
            label(for='description') Description:
            input#email.form-control(type='text', value=photo.description name='description')

          div.form-group
            label(for='location') Location:
            input#email.form-control(type='text', value=photo.location name='location')
          div.form-group
            label(for='year') Year:
            input#email.form-control(type='text', value=photo.year name='year')
            
          div.form-group
            label(for='occasion') Occasion:
            input#email.form-control(type='text', value=photo.occasion name='occasion')
          button.btn.btn-primary(type='submit' style='background-color: green;') Update Your Photo

          a.btn.btn-danger(href='/photos' style='margin: 0;') Exit Without Saving

